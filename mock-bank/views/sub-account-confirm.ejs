<table class="wrap" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td class="td1">
      <div class="box">
        <div class="hdr">
          <table cellpadding="0" cellspacing="0">
            <tr><td class="cell">Review Sub-Account &mdash; <%= member.name %></td></tr>
          </table>
        </div>
        <div class="body">
          <div class="row">
            <span class="c3">This action cannot be undone. Please review before confirming.</span>
          </div>
          <div class="row">
            <table cellpadding="0" cellspacing="0">
              <tr>
                <td class="cell">
                  <div class="inner">
                    <table cellpadding="0" cellspacing="0">
                      <tr class="row">
                        <td class="cell"><label>Member</label></td>
                        <td class="cell"><span class="val"><%= member.name %></span></td>
                      </tr>
                      <tr class="row">
                        <td class="cell"><label>Sub-Account Type</label></td>
                        <td class="cell"><span class="val"><%= pending.subAccountType %></span></td>
                      </tr>
                      <tr class="row">
                        <td class="cell"><label>Opening Deposit</label></td>
                        <td class="cell"><span class="val"><%= pending.openingDeposit %></span></td>
                      </tr>
                    </table>
                  </div>
                </td>
              </tr>
            </table>
          </div>
          <form method="POST" action="/member/<%= member.id %>/sub-account/confirm">
            <div class="btnwrap">
              <table cellpadding="0" cellspacing="0">
                <tr><td class="td1"><button type="submit">Confirm</button></td></tr>
              </table>
            </div>
          </form>
          <div class="row">
            <table cellpadding="0" cellspacing="0">
              <tr><td class="td1"><a href="/member/<%= member.id %>/sub-account">Cancel</a></td></tr>
            </table>
          </div>
        </div>
      </div>
    </td>
  </tr>
</table>
