<table class="wrap" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td class="td1">
      <div class="box">
        <div class="hdr">
          <table cellpadding="0" cellspacing="0">
            <tr><td class="cell">Member Detail</td></tr>
          </table>
        </div>
        <div class="body">
          <% if (error === "permission") { %>
            <div class="row"><span class="c2">You are not authorized</span></div>
          <% } else if (error === "not_found") { %>
            <div class="row"><span class="c2">Record not found</span></div>
          <% } else { %>
            <div class="row">
              <table cellpadding="0" cellspacing="0">
                <tr>
                  <td class="cell">
                    <div class="inner">
                      <table cellpadding="0" cellspacing="0">
                        <tr class="row">
                          <td class="cell"><label>Member Name</label></td>
                          <td class="cell"><span class="val"><%= member.name %></span></td>
                        </tr>
                        <tr class="row">
                          <td class="cell">
                            <div class="inner2">
                              <table cellpadding="0" cellspacing="0">
                                <tr class="row">
                                  <td class="cell"><label>Savings Balance</label></td>
                                  <td class="cell"><span class="val"><%= member.balance %></span></td>
                                </tr>
                              </table>
                            </div>
                          </td>
                        </tr>
                      </table>
                    </div>
                  </td>
                </tr>
              </table>
            </div>
            <div class="row">
              <table cellpadding="0" cellspacing="0">
                <tr><td class="td1"><a href="/member/<%= member.id %>/sub-account">Open Sub-Account</a></td></tr>
              </table>
            </div>
          <% } %>
          <div class="row">
            <table cellpadding="0" cellspacing="0">
              <tr><td class="td1"><a href="/search">Back to Search</a></td></tr>
            </table>
          </div>
        </div>
      </div>
    </td>
  </tr>
</table>
